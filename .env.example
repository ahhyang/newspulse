# Copy to `.env` and fill in. Never commit `.env`.

SPRING_PROFILES_ACTIVE=dev

# Local Docker Postgres (docker-compose service `db`)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/newspulse
SPRING_DATASOURCE_USERNAME=newspulse
SPRING_DATASOURCE_PASSWORD=newspulse

# Neon production (optional). When set, the API converts postgres:// to JDBC.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRATION_MS=86400000
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-me

GNEWS_API_KEY=
GNEWS_BASE_URL=https://gnews.io/api/v4
GNEWS_ENABLED=true
GNEWS_LANG=en
GNEWS_MAX_RESULTS=10

HN_ENABLED=true
HN_BASE_URL=https://hn.algolia.com/api/v1
HN_MAX_RESULTS=20

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3-haiku
OPENROUTER_HTTP_REFERER=https://github.com/ahhyang/newspulse

CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:4173
INGESTION_ENABLED=true
INGESTION_INTERVAL_MS=3600000
INGESTION_INITIAL_DELAY_MS=20000
INGESTION_LOOKBACK_HOURS=24
ENRICHMENT_ENABLED=true
ENRICHMENT_INTERVAL_MS=120000
ENRICHMENT_INITIAL_DELAY_MS=40000
ENRICHMENT_BATCH_SIZE=8
LLM_ENABLED=true
DIGEST_ENABLED=true
DIGEST_CRON=0 5 0 * * *
DIGEST_MAX_ITEMS=10
DIGEST_CLUSTER_SIMILARITY=0.45
